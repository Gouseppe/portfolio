---
//astro components
import Layout from "@/layouts/Layout.astro";
import Circle from "@/components/Circle.astro";
import Button from "@/components/Button.astro";
import AboutMe from "@/sections/AboutMe.astro";
import NavBar from "@/components/NavBar.astro";
//images
import { Image } from "astro:assets";
import presentationImage from "@/assets/presentation-image.webp";
import meWaving from "@/assets/me-waving.webp";
import mePlaying from "@/assets/me-playing.webp";
import meCoding from "@/assets/me-coding.webp";
//lucide icons
import { Mail, Download } from "@lucide/astro";
import Projects from "@/sections/Projects.astro";
import ContactMe from "@/sections/ContactMe.astro";
//icons
import Github from "@/assets/icons/GitHub_Invertocat_White.svg";
import Linkedin from "@/assets/icons/InBug-White.png";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

import { textPage } from "@/store/textPage";
const t = textPage;
const { lang } = Astro.params as { lang: "es" | "en" };
const l = lang;
---

<Layout title="mi pagina web" description="" lang={lang}>
  <div class="black-screen"></div>
  <main>
    <div class="navbar-container">
      <NavBar lang={lang} />
    </div>
    <div class="section fixed circle-layer">
      <div class="circle-container">
        <!-- <div class="circle"></div> -->
        <Circle colorPC="#1a5ae959" colorMobile="#1a5ae98a" />
      </div>
    </div>
    <div class="section hero section-1" id="home">
      <div class="hero__left-side">
        <div class="hero__greeting">
          <div>
            <p>{t.hero.greeting.hi[l]}</p>
            <span class="emoji">👋</span>
          </div>
          <p>{t.hero.greeting.name[l]}</p>
        </div>
        <div class="hero__phrase">
          <p>{t.hero.phrase.text[l]}</p>
          <p>{t.hero.phrase.author[l]}</p>
        </div>
        <div class="right-side__buttons-container mobile">
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.linkedinAria[l]}
              href="https://www.linkedin.com/in/fernando-guzm%C3%A1n-18177b313/"
            >
              <img src={Linkedin.src} width={"100%"} height={"100%"} alt="" />
            </Button>
          </div>
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.githubAria[l]}
            >
              <Github width={"100%"} height={"100%"} />
            </Button>
          </div>
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.emailAria[l]}
              href="mailto:gouseppe.dev@gmail.com"
            >
              <Mail width={"100%"} height={"100%"} />
            </Button>
          </div>
        </div>
        <div class="resume-container">
          <div class="download-icon">
            <a
              href={presentationImage.src}
              download="Fernando_Gouseppe_Resume"
              aria-label={t.social.downloadResume[l]}
            >
              <Download />
            </a>
          </div>
          <a href={presentationImage.src} download="Fernando_Gouseppe_Resume">
            <img src={presentationImage.src} alt={t.social.downloadResume[l]} />
          </a>
        </div>
      </div>
      <div class="hero__right-side">
        <div class="me-images">
          <Image
            class="me-waving"
            src={meWaving}
            alt=""
            eagerly-loaded
            format={"webp"}
            loading="eager"
          />
          <Image class="me-playing" src={mePlaying} alt="" loading="eager" />
          <Image class="me-coding" src={meCoding} alt="" loading="eager" />
        </div>
        <div class="right-side__buttons-container">
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.linkedinAria[l]}
              href="https://www.linkedin.com/in/fernando-guzm%C3%A1n-18177b313/"
            >
              <img src={Linkedin.src} width={"100%"} height={"100%"} alt="" />
            </Button>
          </div>
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.githubAria[l]}
              href="https://github.com/gouseppe"
            >
              <Github width={"100%"} height={"100%"} />
            </Button>
          </div>
          <div class="right-side__button-container">
            <Button
              text=""
              iconPosition="right"
              ariaLabel={t.social.emailAria[l]}
              href="mailto:gouseppe.dev@gmail.com"
            >
              <Mail width={"100%"} height={"100%"} />
            </Button>
          </div>
        </div>
      </div>
      <div class="hero__greeting mobile">
        <p>{t.hero.greeting.welcome[l]}</p>
        <span class="emoji mobile">👋</span>
      </div>
    </div>
    <div class="section-2" id="about">
      <AboutMe lang={lang} />
    </div>
    <div class="section-3" id="projects">
      <Projects lang={lang} />
    </div>
    <div class="section-4" id="contact">
      <ContactMe lang={lang} />
    </div>
  </main>
</Layout>
<script>
  import Circle from "@/components/Circle.astro";
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  // Register the ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;
  let isFirstLoad = true;
  let circleTl: gsap.core.Timeline | undefined;
  let activeBuildCircle: (() => void) | undefined;

  function isMobile() {
    // 1. Revisar API moderna si está disponible
    if (
      "userAgentData" in navigator &&
      typeof (navigator as any).userAgentData.mobile === "boolean"
    ) {
      // alert("userAgentData: " + (navigator as any).userAgentData.mobile);
      return (navigator as any).userAgentData.mobile;
    }

    // 2. Comprobar mediante expresiones regulares el userAgent tradicional
    const patronMovil =
      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i;
    if (patronMovil.test(navigator.userAgent)) {
      // alert("mobile: true");
      return true;
    }

    // 3. Apoyo secundario por puntos de contacto táctil
    // alert("maxTouchPoints: " + navigator.maxTouchPoints);
    return navigator.maxTouchPoints > 1;
  }

  document.addEventListener("astro:before-swap", () => {
    activeBuildCircle = undefined;
    circleTl?.kill();
    circleTl = undefined;
    ctx?.revert();
  });

  document.addEventListener("astro:page-load", () => initPage());

  let resizeTimer: number | undefined;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => activeBuildCircle?.(), 150);
  });

  window.addEventListener("load", () => ScrollTrigger.refresh());

  function buildCircle() {
    // alert("buildCircle");

    const circleContainer = document.querySelector(
      ".circle-container",
    ) as HTMLElement | null;
    const circleLayer = document.querySelector(
      ".circle-layer",
    ) as HTMLElement | null;
    if (!circleContainer || !circleLayer) return;

    if (isMobile()) return;

    // Cache layout reads una sola vez por construccion
    const cachedWidth = circleLayer.clientWidth;
    const cachedHeight = circleLayer.clientHeight;
    const containerW = circleContainer.clientWidth;
    const containerH = circleContainer.clientHeight;

    const centerX = cachedWidth / 2 - containerW / 2;
    const centerY = cachedHeight / 2 - containerH / 2;
    const bottomRight = cachedWidth - containerW;
    const bottomY = cachedHeight - containerH;

    const vh = window.innerHeight;
    const total = document.documentElement.scrollHeight - vh;
    if (total <= 0) return;
    const seg = vh / total;

    const win = (el: Element | null) => {
      if (!el) return 0;
      return (
        (el.getBoundingClientRect().top + window.scrollY - window.innerHeight) /
        total
      );
    };

    const s2 = win(document.querySelector(".section-2"));
    const s3 = win(document.querySelector(".section-3"));
    const s4 = win(document.querySelector(".section-4"));

    circleTl?.kill();
    circleTl = gsap.timeline({
      duration: 1,
      scrollTrigger: {
        trigger: document.querySelector("main") || document.body,
        start: "top top",
        end: "bottom bottom",
        scrub: 1,
        invalidateOnRefresh: true,
      },
    });
    circleTl
      .to(
        circleContainer,
        { x: centerX, y: centerY, duration: seg, ease: "none" },
        s2,
      )
      .to(
        circleContainer,
        { x: 0, y: bottomY, duration: seg, ease: "none" },
        s3,
      )
      .to(
        circleContainer,
        { x: bottomRight, y: bottomY, duration: seg, ease: "none" },
        s4,
      );
  }

  function initPage() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    ctx = gsap.context(() => {
      // ---------- circulo: movimiento (PC) y color (crossfade al llegar a cada seccion)
      buildCircle();

      const circleLayers = Array.from(
        document.querySelectorAll(".circle-stack .circle"),
      ) as HTMLElement[];
      const setActiveCircle = (name: string) => {
        circleLayers.forEach((el) =>
          el.classList.toggle(
            "is-active",
            el.classList.contains(`circle--${name}`),
          ),
        );
      };

      const circleSections = [
        { sel: ".section-2", name: "s2" },
        { sel: ".section-3", name: "s3" },
        { sel: ".section-4", name: "s4" },
      ];
      circleSections.forEach(({ sel, name }, i) => {
        ScrollTrigger.create({
          trigger: sel,
          start: "top center",
          onEnter: () => setActiveCircle(name),
          onLeaveBack: () =>
            setActiveCircle(i === 0 ? "base" : circleSections[i - 1].name),
        });
      });

      gsap.to("html", {
        "--button-color": "rgba(128, 0, 128, 0.50)",
        "--button-color-hover": "rgba(128, 0, 128)",
        scrollTrigger: {
          trigger: ".section-2",
          start: "top center",
          end: "bottom center",
          toggleActions: "restart none restart reverse",
        },
      });
      gsap.to("html", {
        "--button-color": "rgba(230, 230, 85, 0.26)",
        "--button-color-hover": "rgba(230, 230, 85)",
        scrollTrigger: {
          trigger: ".section-3",
          start: "top center",
          end: "bottom center",
          toggleActions: "restart none restart none",
        },
      });
      gsap.to("html", {
        "--button-color": "#59272759",
        "--button-color-hover": "#592727ff",
        scrollTrigger: {
          trigger: ".section-4",
          start: "top center",
          end: "bottom center",
          toggleActions: "restart none none none",
        },
      });

      // ---------- animacion de la navbar
      if (prefersReducedMotion) {
        gsap.set(".navbar-container", { y: 0, autoAlpha: 1, zIndex: 100 });
      } else {
        gsap.set(".navbar-container", { y: -100, autoAlpha: 0 });
        gsap.to(".navbar-container", {
          y: 0,
          duration: 1,
          ease: "power1.out",
          autoAlpha: 1,
          zIndex: 100,
          delay: isFirstLoad ? 3.5 : 0,
        });
      }
      const elemento = document.querySelector(
        ".navbar-container",
      ) as HTMLElement;
      let navTween: gsap.core.Tween | null = null;
      ScrollTrigger.create({
        start: `top -100`,
        onUpdate: (self) => {
          if (navTween) navTween.kill();
          if (self.direction === 1) {
            navTween = gsap.to(elemento, {
              yPercent: -100,
              duration: 0.3,
              ease: "power2.out",
            });
          } else if (self.direction === -1) {
            navTween = gsap.to(elemento, {
              yPercent: 0,
              duration: 0.3,
              ease: "power2.out",
            });
          }
        },
      });

      // ---------- animacion de mi persona
      if (prefersReducedMotion) {
        gsap.set(".me-waving", { autoAlpha: 1 });
      } else {
        const meImagesTl = gsap.timeline({
          repeat: -1,
          delay: isFirstLoad ? 3 : 0,
        });

        meImagesTl
          .set(".me-waving", { autoAlpha: 1, rotation: 0, x: 0 }, 0)
          .set(".me-playing, .me-coding", { autoAlpha: 0 }, 0)
          // Animación de balanceo
          .to(
            ".me-waving",
            { rotation: 5, x: 10, duration: 0.3, ease: "power1.inOut" },
            0.1,
          )
          .to(
            ".me-waving",
            { rotation: -5, x: -10, duration: 0.3, ease: "power1.inOut" },
            0.4,
          )
          .to(
            ".me-waving",
            { rotation: 0, x: 0, duration: 0.2, ease: "power1.inOut" },
            0.7,
          )
          // Segunda imagen: .me-playing
          .set(".me-playing", { autoAlpha: 1, y: 0 }, 2)
          .set(".me-waving, .me-coding", { autoAlpha: 0 }, 2)
          // Animación de salto
          .to(".me-playing", { y: -20, duration: 0.3, ease: "power1.out" }, 2.1)
          .to(".me-playing", { y: 0, duration: 0.4, ease: "bounce.out" }, 2.4)

          // Tercera imagen: .me-coding
          .set(".me-coding", { autoAlpha: 1, scale: 1 }, 4)
          .set(".me-waving, .me-playing", { autoAlpha: 0 }, 4)
          // Animación de zoom
          .to(
            ".me-coding",
            { scale: 1.05, duration: 0.2, ease: "power1.inOut" },
            4.1,
          )
          .to(
            ".me-coding",
            { scale: 1, duration: 0.3, ease: "power1.inOut" },
            4.3,
          )
          // Pausa para la última imagen
          .to({}, { duration: 2 }, 5);
      }

      const pickEmoji = () => {
        const isMobileViewport =
          window.matchMedia("(max-width: 767px)").matches;
        return (
          isMobileViewport
            ? document.querySelector(".emoji.mobile")
            : document.querySelector(".emoji:not(.mobile)")
        ) as HTMLElement | null;
      };

      if (isFirstLoad && !prefersReducedMotion) {
        // ---------- intro completa (solo primera carga, tecnica FLIP con transforms)
        const emoji = pickEmoji();

        let hoverBusy = false;
        const attachHoverWave = () => {
          if (!emoji) return;
          emoji.addEventListener("mouseenter", () => {
            if (hoverBusy) return;
            hoverBusy = true;
            gsap.to(emoji, {
              rotation: 20,
              duration: 0.5,
              yoyo: true,
              repeat: 3,
              transformOrigin: "bottom right",
              ease: "power1.inOut",
              onComplete: () => {
                hoverBusy = false;
              },
            });
          });
        };

        const playIntro = () => {
          if (!emoji) {
            document.body.style.overflowY = "auto";
            gsap.set(".right-side__button-container", { opacity: 1, y: 0 });
            gsap.set(".black-screen", { autoAlpha: 0, zIndex: -1 });
            return;
          }

          // FLIP: medir el lugar natural del emoji y colocarlo en el centro solo con transforms.
          // El segundo set mide el rect ya escalado para centrar exacto sin importar transformOrigin.
          gsap.set(emoji, { scale: 4, transformOrigin: "bottom right" });
          const rect = emoji.getBoundingClientRect();
          gsap.set(emoji, {
            x: window.innerWidth / 2 - (rect.left + rect.width / 2),
            y: window.innerHeight / 2 - (rect.top + rect.height / 2),
          });

          gsap
            .timeline({
              defaults: { ease: "power1.inOut" },
              onComplete: attachHoverWave,
            })
            .to(emoji, { opacity: 1, duration: 0.9 })
            .to(emoji, {
              rotation: 20,
              yoyo: true,
              repeat: 3,
              duration: 0.5,
            })
            .to(emoji, { x: 0, y: 0, scale: 1, duration: 0.5, delay: 0.5 })
            .to(".black-screen", { autoAlpha: 0, duration: 0.5 })
            .set(".black-screen", { zIndex: -1 })
            .set("body", { overflowY: "auto" })
            .fromTo(
              ".right-side__button-container",
              { y: 20, opacity: 0 },
              {
                duration: 1,
                stagger: 0.15,
                y: 0,
                opacity: 1,
                ease: "sine.out",
              },
            );
        };

        // Esperar a que la fuente cargue para medir la posicion natural sin desfases
        if (document.fonts?.ready) {
          document.fonts.ready.then(playIntro);
        } else {
          playIntro();
        }
      } else {
        // ---------- entrada rapida al navegar (o movimiento reducido)
        document.body.style.overflowY = "auto";
        if (prefersReducedMotion) {
          // Estado final directo, sin animaciones
          const emoji = pickEmoji();
          if (emoji) gsap.set(emoji, { opacity: 1 });
          gsap.set(".right-side__button-container", { opacity: 1, y: 0 });
          gsap.set(".navbar-container", { y: 0, autoAlpha: 1, zIndex: 100 });
          gsap.set(".black-screen", { autoAlpha: 0, zIndex: -1 });
        } else {
          gsap.fromTo(
            ".right-side__button-container",
            { y: 20, opacity: 0 },
            {
              duration: 1,
              stagger: 0.15,
              y: 0,
              opacity: 1,
              ease: "sine.out",
            },
          );
          gsap.to(".black-screen", {
            autoAlpha: 0,
            duration: 0.5,
            onComplete: () => gsap.set(".black-screen", { zIndex: -1 }),
          });
        }
      }
    });
    activeBuildCircle = isMobile() ? undefined : buildCircle;
    isFirstLoad = false;
  }
</script>
<style>
  /* :root {
	--font-size-base: clamp(1rem, 0.34vw + 0.91rem, 1.19rem);
	--font-size-lg: clamp(1.2rem, 0.7vw + 1.2rem, 1.5rem);
	--font-size-xl: clamp(2.44rem, 2.38vw + 1.85rem, 3.75rem);
  } */

  .fixed {
    position: fixed;
    top: 0px;
    z-index: -1;
  }

  * {
    color: white;
  }
  body {
    overflow-x: hidden;
    overflow-y: hidden;
  }
  .navbar-container {
    position: fixed;
    padding-top: 4vh;
    width: 100%;
    z-index: 10;
    will-change: transform;
  }
  .me-images {
    overflow: hidden;
  }
  .me-images img {
    position: absolute;
    opacity: 0;
  }

  .circle-container {
    position: absolute;
    top: 0px;
    left: 0px;
    z-index: 0;
    will-change: transform;
  }
  .section-1,
  .section-2,
  .section-3,
  .section-4,
  .section-5 {
    width: 100%;
    padding: 2.5rem var(--page-gutter);
    display: flex;
    justify-content: center;
  }

  .section {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    font-size: 1.5rem;
    text-align: center;

    padding: 2.5rem var(--page-gutter);
  }

  .hero {
    flex-direction: row;
    position: relative;
  }
  .hero__left-side,
  .hero__right-side {
    display: flex;
    flex-direction: column;
    flex: 1;
    height: 100%;
  }
  .hero__left-side {
    align-items: center;
    justify-content: center;
    gap: 50px;
  }
  .hero__greeting {
    display: flex;
    width: 100%;
    font-size: var(--font-title);
    flex-direction: column;
    text-align: left;
    margin-left: 2rem;
  }
  .hero__greeting div {
    display: flex;
    align-items: center;
  }

  .hero__phrase {
    font-size: var(--font-subtitle);
    text-align: right;
  }

  .hero__right-side {
    align-items: center;
    justify-content: center;
  }
  .right-side__button-container {
    opacity: 0;
  }
  .right-side__buttons-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }
  .me-images {
    position: relative;
    max-width: 500px;
    width: 100%;
    aspect-ratio: 1/1;
    text-align: left;
  }
  .resume-container {
    position: relative;
  }
  .download-icon {
    position: absolute;
    right: 15px;
    top: 5px;
    transition: transform 0.3s ease-in-out;
    cursor: pointer;
  }
  .download-icon:hover {
    transform: scale(1.2);
  }
  img {
    width: 100%;
    height: auto;
  }
  .black-screen {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 15;
    height: 100vh;
    width: 100%;
    background-color: #05010d;
  }

  .emoji {
    /* Vive en el flujo natural (flex item junto al saludo); la intro lo
       desplaza solo con transforms y al terminar queda exactamente aqui */
    transform-origin: bottom center;
    z-index: 40;
    opacity: 0;
  }
  @media (min-width: 768px) {
    .mobile {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .navbar-container {
      padding-top: 2vh;
    }
    .hero {
      flex-direction: column-reverse;
      overflow: hidden;
      width: 100%;
      gap: 1rem;
      justify-content: center;
      margin-top: 2.5rem;
    }
    .hero__greeting:not(.mobile) {
      display: none;
    }
    .hero__greeting.mobile {
      display: flex;
      flex-direction: row;
      font-size: var(--font-title);
      align-items: center;
      justify-content: center;
      margin: 0px;
      gap: 0px;
    }

    .hero__right-side {
      width: 60%;
      flex: 0;
    }
    .right-side__buttons-container {
      display: flex;
    }
    .right-side__buttons-container:not(.mobile) {
      display: none !important;
    }
    .hero__phrase {
      text-align: center;
      max-width: 36ch;
      margin-inline: auto;
      line-height: 1.5;
    }
    .hero__left-side {
      flex: 0;
      width: 100%;
      gap: 15px;
    }
    .me-images {
      overflow: visible;
    }
  }
</style>
