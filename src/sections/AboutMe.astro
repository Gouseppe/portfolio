---
import Badge from "@/components/Badge.astro";
import { textPage } from "@/store/textPage";
//icons
import { Contact } from "@lucide/astro";
//images
import school from "@/assets/school.png";
import laptop from "@/assets/laptop.png";
//svg's
import react from "@/assets/icons/CibReact 1.svg";
import laravel from "@/assets/icons/Fa6BrandsLaravel 1.svg";
import astro from "@/assets/icons/SimpleIconsAstro 1.svg";
import figma from "@/assets/icons/FaBrandsFigma 1.svg";
import nestjs from "@/assets/icons/SimpleIconsNestjs 1.svg";
import typescript from "@/assets/icons/FileIconsTypescript 1.svg";

const svgs = [react, laravel, astro, figma, nestjs, typescript];
interface Props {
  lang: "es" | "en";
}

const t = textPage;
const { lang } = Astro.props;
const l = lang;
---

<section class="section">
  <div class="title-wrapper">
    <Contact size={"2.5rem"} />
    <h2 class="title">{t.aboutMe.title[l]}</h2>
  </div>

  <div class="content-wrapper">
    <div class="content-wrapper__column">
      <div class="floating">
        <img
          src={school.src}
          alt="illustration frontend"
          class="float-image uno"
        />

        <p>{t.aboutMe.description.p1[l]}</p>
        <p>{t.aboutMe.description.p2[l]}</p>
      </div>

      <h3 class="sub-title">{t.aboutMe.frontend.title[l]}</h3>
      <div class="floating">
        <img
          src={laptop.src}
          alt="illustration frontend"
          class="float-image dos"
        />
        <p>{t.aboutMe.frontend.p1[l]}</p>
      </div>
    </div>
    <div class="content-wrapper__column">
      <h3 class="sub-title">{t.aboutMe.backend.title[l]}</h3>
      <p>{t.aboutMe.backend.p1[l]}</p>
      <p>{t.aboutMe.backend.p2[l]}</p>
      <h3 class="sub-title">{t.aboutMe.skills[l]}</h3>
      <div class="badge-list">
        {
          svgs.map((svg) => (
            <div class="badge-item">
              <Badge size="60px" ariaLabel={t.aboutMe.skills[l]}>
                <img src={svg.src} alt="" />
              </Badge>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";

  // Usamos una función para encapsular el scope
  function initAnimations() {
    const container = document.querySelector(".badge-list") as HTMLDivElement;

    const items = container.querySelectorAll(".badge-item");

    // 2. Usamos gsap.fromTo directamente y le añadimos el objeto scrollTrigger
    gsap.fromTo(
      items,
      {
        y: 20,
        opacity: 0, // Añadido al estado inicial para evitar parpadeos antes del scroll
      },
      {
        duration: 0.8,
        stagger: 0.1,
        y: 0,
        opacity: 1,
        ease: "power2.out",
        force3D: true,
        scrollTrigger: {
          trigger: container, // El elemento que vigilamos
          start: "top 80%", // Equivale a tu threshold: 0.2
          once: true, // Equivale a tu observer.disconnect()
        },
      },
    );
  }

  // Ejecutar cuando el DOM esté listo
  document.addEventListener("DOMContentLoaded", initAnimations);
</script>

<style>
  section {
    z-index: 99;
  }
  p {
    text-align: left;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .content-wrapper {
    display: flex;
    flex-direction: row;
    gap: 32px;
    width: 100%;
  }
  .content-wrapper__column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge-list {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .badge-item {
    opacity: 0; /* Inicialmente ocultos para la animación */
  }
  .floating {
    text-align: left;
  }
  .sub-title {
    margin-top: 1.5rem;
  }

  .float-image.uno {
    float: right;
    width: 150px;
    margin-left: 10px;
    shape-outside: circle(50% at 50% 50%);
  }
  .float-image.dos {
    float: left;
    width: 150px;
    margin-right: 10px;
    shape-outside: circle(50% at 50% 50%);
  }

  .floating::after {
    content: "";
    display: block;
    clear: both;
  }

  @media (max-width: 900px) {
    .content-wrapper {
      flex-direction: column;
      gap: 40px;
    }
    .float-image.uno,
    .float-image.dos {
      float: none;
      display: block;
      margin: 0 auto 16px auto;
    }
    .title-wrapper {
      margin-bottom: 1.5rem;
    }
  }
</style>
