---
import Card from "../components/Card.astro";
import { textPage } from "@/store/textPage";
// img's
import islaBonita from "@/assets/projects/isla-bonita/isla-bonita-image1.webp";
import islaBonita2 from "@/assets/projects/isla-bonita/isla-bonita-image2.webp";
import islaBonita3 from "@/assets/projects/isla-bonita/isla-bonita-image3.webp";
import islaBonitaCard from "@/assets/projects/isla-bonita/isla-bonita-image-card.png";
import phylumAi from "@/assets/projects/phylum-ai/phylum-ai-image1.webp";
import phylumAi2 from "@/assets/projects/phylum-ai/phylum-ai-image2.webp";
import phylumAi3 from "@/assets/projects/phylum-ai/phylum-ai-image3.webp";
import phylumAiCard from "@/assets/projects/phylum-ai/phylum-ai-card.png";
import siseCard from "@/assets/projects/sise/sise-card.png";
import sise1 from "@/assets/projects/sise/sise-image1.webp";
import sise2 from "@/assets/projects/sise/sise-image2.webp";
import sise3 from "@/assets/projects/sise/sise-image3.webp";
import sise4 from "@/assets/projects/sise/sise-image4.webp";
import sise5 from "@/assets/projects/sise/sise-image5.webp";
import pokedexCard from "@/assets/projects/pokedex/pokedex-card.webp";
import pokedex1 from "@/assets/projects/pokedex/pokedex-image1.webp";
import pokedex2 from "@/assets/projects/pokedex/pokedex-image2.webp";
import pokedex3 from "@/assets/projects/pokedex/pokedex-image3.webp";
import pokedex4 from "@/assets/projects/pokedex/pokedex-image4.webp";
// svg's
import react from "@/assets/icons/CibReact 1.svg";
import astro from "@/assets/icons/SimpleIconsAstro 1.svg";
import typescript from "@/assets/icons/FileIconsTypescript 1.svg";
// lucide's icons
import { FolderTree } from "@lucide/astro";
// icons
import mui from "@/assets/icons/mui.svg";
import tailwind from "@/assets/icons/tailwindcss.svg";
interface Props {
  lang: "es" | "en";
}

const t = textPage;
const { lang } = Astro.props;
const l = lang;

const projects = [
  {
    title: "Isla Bonita",
    description:
      l === "es"
        ? "Esta es una Landing Page moderna e interactiva desarrollada con React y Material-UI (MUI). El enfoque principal fue crear una experiencia de usuario fluida y completamente responsiva, adaptándose a la perfección tanto a dispositivos móviles como de escritorio. Cuenta con animaciones personalizadas utilizando Emotion (CSS-in-JS), un carrusel de imágenes automático y efectos visuales dinámicos (como escritura animada) que le dan vida a la identidad vibrante y tropical del proyecto."
        : "This is a modern and interactive Landing Page built with React and Material-UI (MUI). The main focus was to create a seamless and fully responsive user experience, adapting perfectly to both mobile and desktop devices. It features custom animations using Emotion (CSS-in-JS), an auto-playing image carousel, and dynamic visual effects (like animated typing) that bring the project's vibrant and tropical identity to life.",
    badgeimages: [react, mui, typescript],
    img: islaBonitaCard,
    badgeShadowColor: "rgba(230, 230, 85, 0.26)",
    imgSlides: [islaBonita, islaBonita2, islaBonita3],
    projectLink: "https://ecommerce-h88a.onrender.com/landing-page",
  },
  {
    title: "Phylum AI",
    description:
      l === "es"
        ? "      ? El proyecto Phylum AI es una aplicación web interactiva con un enfoque educativo y científico, diseñada para funcionar como un sistema experto (o motor de inferencia) biológico. Su propósito principal es guiar a los usuarios a través de un cuestionario dinámico para clasificar organismos vivos en su respectivo filo (phylum)."
        : "The Phylum AI project is an interactive web application with an educational and scientific focus, designed to function as a biological expert system (or inference engine). Its main purpose is to guide users through a dynamic questionnaire to classify living organisms into their respective phylum.",
    badgeimages: [react, typescript],
    img: phylumAiCard,
    badgeShadowColor: "rgba(230, 230, 85, 0.26)",
    imgSlides: [phylumAi, phylumAi2, phylumAi3],
    projectLink: "https://phylum-ai.vercel.app/",
  },
  {
    title: "SISE",
    description:
      l === "es"
        ? "Trabaje en un equipo de cuatro personas por cinco meses para la creación de una aplicación web del área de salud encargada para la administración y generaciones de pdf’s de los registros médicos de los distintos empleados de las empresas. Encargado del diseño de la interfaz de usuario (UI) y de la creación de dichas ventanas, use herramientas como reactjs, typescript y MUI"
        : "Collaborated in a four-person team over five months to develop a healthcare web application for managing and generating PDF medical records for corporate employees. Led the User Interface (UI) design and frontend development, utilizing React.js, TypeScript, and MUI.",
    badgeimages: [react, typescript, mui],
    img: siseCard,
    badgeShadowColor: "rgba(230, 230, 85, 0.26)",
    imgSlides: [sise1, sise2, sise3, sise4, sise5],
  },
  {
    title: "Pokedex",
    description:
      l === "es"
        ? "Proyecto con la finalidad de buscar y acceder a la información de todos los pokemones disponibles actualmente. Para este proyecto utilice astro, reactjs,typescript y tailwind"
        : "Developed a project aimed at searching and accessing information for all currently available Pokémon. Built utilizing Astro, React.js, TypeScript, and Tailwind CSS.",
    badgeimages: [react, typescript, astro, tailwind],
    img: pokedexCard,
    badgeShadowColor: "rgba(230, 230, 85, 0.26)",
    imgSlides: [pokedex1, pokedex2, pokedex3, pokedex4],
    projectLink: "https://pokedex-web-astro.vercel.app/",
  },
];
---

<section class="section">
  <div class="title-wrapper">
    <FolderTree size={"2.5rem"} />
    <h2 class="title">{t.projects.title[l]}</h2>
  </div>
  <p>{t.projects.description[l]}</p>
  <div
    class="projects-wrapper"
    role="region"
    aria-label={t.projects.title[l]}
    tabindex="0"
  >
    <div class="projects">
      {
        projects.map((project) => (
          <Card
            title={project.title}
            description={project.description}
            badgeimages={project.badgeimages}
            img={project.img}
            badgeShadowColor="rgba(230, 230, 85, 0.26)"
            imgSlides={project.imgSlides}
            projectLink={project.projectLink}
          />
        ))
      }
    </div>
  </div>

  <script>
    // Carrusel con scroll nativo: el navegador limita el desplazamiento al
    // contenido real, así el último paso avanza solo lo necesario para mostrar
    // las cards restantes. En táctil el movimiento es nativo (sin drag
    // propio); el drag con mouse es una mejora progresiva para puntero fino.
    let wrapper: HTMLDivElement | null = null;
    let track: HTMLDivElement | null = null;
    let stride = 0; // Ancho de card + gap
    let autoScrollTimer: ReturnType<typeof setInterval> | undefined;
    let resumeTimer: ReturnType<typeof setTimeout> | undefined;
    let paused = false;
    let dragging = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function maxScroll(): number {
      return wrapper ? wrapper.scrollWidth - wrapper.clientWidth : 0;
    }

    function scrollToX(left: number, smooth = true): void {
      wrapper?.scrollTo({
        left,
        behavior: smooth && !prefersReducedMotion() ? "smooth" : "auto",
      });
    }

    // Mide la distancia entre cards y activa el modo centrado (.single) cuando
    // solo cabe una card completa (aunque asome parte de la siguiente)
    function measure(): void {
      if (!wrapper || !track) return;
      const firstCard = track.firstElementChild as HTMLElement | null;
      if (!firstCard) return;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      stride = firstCard.offsetWidth + gap;

      const single =
        wrapper.clientWidth >= firstCard.offsetWidth &&
        wrapper.clientWidth < stride * 2 - gap;
      wrapper.classList.toggle("single", single);
      // Padding lateral para que la primera/última card puedan quedar centradas
      track.style.paddingInline = single
        ? `${Math.max(0, (wrapper.clientWidth - firstCard.offsetWidth) / 2)}px`
        : "";
    }

    // Paso del auto-scroll: avanza una card; si el siguiente paso excede el
    // final, avanza solo lo que falta; al llegar al final, vuelve al inicio
    function stepForward(): void {
      if (!wrapper || !stride) return;
      const max = maxScroll();
      if (wrapper.scrollLeft >= max - 1) {
        scrollToX(0);
      } else {
        scrollToX(Math.min(wrapper.scrollLeft + stride, max));
      }
    }

    function startAutoScroll(): void {
      stopAutoScroll();
      if (!wrapper || paused) return;
      autoScrollTimer = setInterval(stepForward, 2000);
    }

    function stopAutoScroll(): void {
      if (autoScrollTimer !== undefined) clearInterval(autoScrollTimer);
      autoScrollTimer = undefined;
    }

    // Snap suave a la card más cercana tras soltar el drag, respetando el
    // límite derecho real (último paso parcial)
    function snapToNearest(): void {
      if (!wrapper || !stride) return;
      const max = maxScroll();
      const gridNearest = Math.round(wrapper.scrollLeft / stride) * stride;
      // El límite derecho también es un punto de snap válido
      // (replica el comportamiento nativo de scroll-snap en los bordes)
      const target =
        Math.abs(max - wrapper.scrollLeft) <
        Math.abs(gridNearest - wrapper.scrollLeft)
          ? max
          : gridNearest;
      scrollToX(Math.max(0, Math.min(target, max)));
    }

    // Eventos custom despachados por Card.astro cuando se abre/cierra el dialog
    document.addEventListener("cards:pause", () => {
      paused = true;
      stopAutoScroll();
    });

    document.addEventListener("cards:resume", () => {
      paused = false;
      startAutoScroll();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoScroll();
      } else if (!paused) {
        startAutoScroll();
      }
    });

    window.addEventListener("resize", measure);

    document.addEventListener("astro:before-swap", () => {
      stopAutoScroll();
      if (resumeTimer !== undefined) clearTimeout(resumeTimer);
      resumeTimer = undefined;
    });

    // Drag con mouse: solo en dispositivos con puntero fino (escritorio)
    const canDrag = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;

    if (canDrag) {
      document.addEventListener("mousemove", (e) => {
        if (!dragging || !wrapper) return;
        e.preventDefault(); // Evita selección de texto mientras se arrastra
        wrapper.scrollLeft = dragStartScroll - (e.pageX - dragStartX);
      });

      document.addEventListener("mouseup", () => {
        if (!dragging || !wrapper) return;
        dragging = false;
        wrapper.classList.remove("dragging");
        snapToNearest();
      });
    }

    document.addEventListener("astro:page-load", () => {
      wrapper = document.querySelector(
        ".projects-wrapper",
      ) as HTMLDivElement | null;
      track = document.querySelector(".projects") as HTMLDivElement | null;
      paused = false;
      dragging = false;
      measure();
      startAutoScroll();
      if (!wrapper) return;

      // Pausa al pasar el mouse por encima, reanuda al salir
      wrapper.addEventListener("mouseover", () => {
        if (!paused) stopAutoScroll();
      });
      wrapper.addEventListener("mouseleave", () => {
        if (!paused) startAutoScroll();
      });

      // Táctil: pausa mientras el usuario se desplaza con el dedo
      wrapper.addEventListener(
        "touchstart",
        () => {
          if (!paused) stopAutoScroll();
        },
        { passive: true },
      );
      wrapper.addEventListener(
        "touchend",
        () => {
          if (paused) return;
          if (resumeTimer !== undefined) clearTimeout(resumeTimer);
          // Pequeño margen para no pelear con el momentum/snap del navegador
          resumeTimer = setTimeout(startAutoScroll, 800);
        },
        { passive: true },
      );

      if (!canDrag) return;
      wrapper.addEventListener("mousedown", (e) => {
        if (!wrapper || paused || dragging) return;
        // Ignoramos el drag si el clic nace en un botón (ej. el botón "ver")
        if ((e.target as HTMLElement | null)?.closest("button")) return;
        stopAutoScroll();
        dragging = true;
        dragStartX = e.pageX;
        dragStartScroll = wrapper.scrollLeft;
        wrapper.classList.add("dragging");
        e.preventDefault();
      });
    });
  </script>

  <style>
    h1 {
      margin-bottom: 2rem;
      align-self: center;
    }

    .projects-wrapper {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      cursor: grab;
      width: 100%;
      position: relative;
      mask-image: linear-gradient(
        to right,
        transparent,
        rgba(0, 0, 0, 0.815) 5%,
        rgb(0, 0, 0) 10%,

        /* El contenido empieza a ser 100% visible al 10% del ancho */ black 90%,
        rgba(0, 0, 0, 0.815) 95%,
        /* Se mantiene visible hasta el 90% */ transparent
      );
    }

    .projects-wrapper::-webkit-scrollbar {
      display: none;
    }

    .projects-wrapper:focus-visible {
      outline: 1px solid rgba(107, 70, 255, 0.7);
      outline-offset: 3px;
    }

    .projects-wrapper.dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      user-select: none;
    }

    .projects {
      display: flex;
      gap: 24px;
      width: max-content;
    }

    .projects > :global(astro-card) {
      display: block;
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    /* Táctil: el navegador gestiona el snap de forma nativa */
    @media (hover: none) {
      .projects-wrapper {
        scroll-snap-type: x mandatory;
      }

      /* Modo centrado: solo hay una card completamente visible */
      .projects-wrapper.single .projects > :global(astro-card) {
        scroll-snap-align: center;
      }
    }
  </style>
</section>
