---
import Loader from "./Loader.astro";

interface Props {
  iconPosition: "left" | "right";
  text?: string;
  ariaLabel: string;
  width?: string;
  form?: string;
  size?: "small" | "medium" | "large";
}

let {
  iconPosition,
  text,
  ariaLabel,
  width = "76px",
  form,
  size = "medium",
} = Astro.props;
---

<div class={`form-button-wrapper size-${size}`} style={`width: ${width};`}>
  <button
    class={`form-button size-${size}`}
    form={form}
    type="submit"
    aria-label={ariaLabel}
    style={`width: ${width};`}
  >
    <div class="content">
      <div class="div-animation">
        {
          iconPosition === "left" && (
            <div class="icon">
              <slot />
              <div class="succesIcon" />
            </div>
          )
        }
        {text && <span>{text}</span>}
        {
          iconPosition === "right" && (
            <div class="icon">
              <slot />
            </div>
          )
        }
      </div>
    </div>
    <div class="loader-wrapper">
      <Loader />
    </div>
    <div class="success-message">Enviado correctamente</div>
    <div class="error-message">Error</div>
  </button>
</div>

<script>
  let button: HTMLButtonElement | null = null;
  let content: HTMLDivElement | null = null;
  document.addEventListener("astro:page-load", () => {
    button = document.querySelector(".form-button") as HTMLButtonElement;
    content = button.querySelector(".content") as HTMLDivElement;
  });
  document.addEventListener("message-success", () => {
    content && content.classList.remove("sending");
    content && content.classList.add("success");
    console.log("message-success event received");
    if (button) {
      button.disabled = false;
      button.style.cursor = "pointer";
      button.classList.add("success");
    }
    setTimeout(() => {
      content && content.classList.remove("success");
    }, 2000);
  });
  document.addEventListener("message-error", () => {
    content && content.classList.remove("sending");
    content && content.classList.add("error");
    console.log("message-error event received");

    if (button) {
      button.disabled = false;
      button.style.cursor = "pointer";
      button.classList.add("error");
    }
    setTimeout(() => {
      content && content.classList.remove("error");
    }, 2000);
  });
  document.addEventListener("sending-message", () => {
    const button = document.querySelector(".form-button") as HTMLButtonElement;
    // if (button) {
    //   button.disabled = true;
    //   button.style.cursor = "not-allowed";
    // }
    console.log("sending-message event received");
    console.log("content", content);
    if (content) {
      // agregar clase "sending" al contenido para animación
      content.classList.add("sending");
    }
  });
</script>

<style>
  /* Wrapper con los cortes poligonales idénticos y borde metálico */
  .form-button-wrapper {
    box-sizing: border-box;
    padding: 1.5px; /* Borde metálico muy fino */
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );

    border-radius: 12px;
    transition:
      background-color 0.3s ease-in-out,
      box-shadow 0.3s ease-in-out;
  }

  /* Botón con fondo translúcido y sombras internas metálicas */
  .form-button {
    position: relative;
    display: flex;
    box-sizing: border-box;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
    background: rgba(
      0,
      0,
      0,
      0.247
    ); /* Mismo fondo translúcido que las cards */
    backdrop-filter: blur(4px);
    border: none;
    cursor: pointer;
    clip-path: polygon(
      0 10px,
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%
    );

    /* Inset shadows idénticos al panel .resume de las cards */
    box-shadow:
      inset 0 1px 10px rgba(255, 86, 86, 0.27),
      inset 0 -1px 10px rgba(255, 86, 86, 0.27),
      inset 0 0 20px -10px rgba(255, 86, 86, 0.27);
    transition: background-color 0.3s ease-in-out;
  }

  /* Control de Altura y Padding por Prop de Size */

  /* 1. Small */
  .form-button.size-small {
    height: 56px;
    padding: 12px 20px;
  }

  .form-button.size-small .content {
    font-size: 1.1rem;
    gap: 8px;
  }

  /* 2. Medium (Default) */
  .form-button.size-medium {
    height: 76px;
    padding: 25px;
  }

  .form-button.size-medium .content {
    font-size: 1.5rem;
    gap: 10px;
  }

  /* 3. Large */
  .form-button.size-large {
    height: 96px;
    padding: 30px;
  }

  .form-button.size-large .content {
    font-size: 1.8rem;
    gap: 12px;
  }

  /* Contenido interno y animación */
  .content {
    width: fit-content;
    transition: transform 0.3s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: #ffffff;
  }
  .div-animation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition:
      transform 1s ease-in-out,
      opacity 1s ease-in-out;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  /* Hover states */
  .form-button:hover .content {
    transform: scale(1.05);
  }

  .form-button:hover {
    background: rgba(
      0,
      0,
      0,
      0.35
    ); /* Fondo ligeramente más oscuro al pasar el cursor */
  }

  /* Focus states */
  .form-button:focus-visible {
    outline: none;
  }

  .success-message,
  .error-message,
  .loader-wrapper {
    color: #ffffff;
    display: block;
    position: absolute;
    opacity: 0;
    top: 50%;
    left: 50%;
    transform: translate(-50%, 100%);
    font-weight: bold;
    transition:
      transform 1s ease-in-out,
      opacity 1s ease-in-out;
  }
  .loader-wrapper {
    display: block;
  }

  .content.sending .div-animation,
  .content.success .div-animation,
  .content.error .div-animation {
    transform: translateY(-750%);
    opacity: 0;
  }

  .content.success ~ .loader-wrapper,
  .content.error ~ .loader-wrapper {
    transform: translate(-50%, -150%);
    opacity: 0;
  }
  .content.success ~ .success-message,
  .content.error ~ .error-message {
    display: block;
    opacity: 1;
    /* que al finalizar la animacion quede en donde termino */

    transform: translate(-50%, -50%);
  }
  .content.sending ~ .loader-wrapper {
    display: block;
    opacity: 1;
    /* que al finalizar la animacion quede en donde termino */

    transform: translate(-50%, -50%);
  }

  /* Responsivo para móviles */
  @media (max-width: 760px) {
    .form-button.size-small {
      height: 48px;
      padding: 10px;
    }

    .form-button.size-medium {
      height: 69px;
      padding: 20px;
    }

    .form-button.size-large {
      height: 85px;
      padding: 22px;
    }
  }
</style>
