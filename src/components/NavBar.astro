---
import { textPage } from "@/store/textPage";
import Button from "./Button.astro";
import { Home, User, Briefcase, Mail } from "@lucide/astro";
interface Props {
  lang: "es" | "en";
}

const t = textPage;
const { lang } = Astro.props;
const l = lang;
---

<ul class="navbar">
  <li class="navbar__item">
    <Button
      text={t.nav.home[l]}
      ariaLabel={t.nav.home[l]}
      link="#hero"
      iconPosition="left"
      target="_self"
      width="auto"
    >
      <Home size={20} />
    </Button>
  </li>
  <li class="navbar__item">
    <Button
      text={t.nav.about[l]}
      ariaLabel={t.nav.about[l]}
      link="#about"
      iconPosition="left"
      target="_self"
      width="auto"
    >
      <User size={20} />
    </Button>
  </li>
  <li class="navbar__item">
    <Button
      text={t.nav.projects[l]}
      ariaLabel={t.nav.projects[l]}
      link="#projects"
      iconPosition="left"
      target="_self"
      width="auto"
    >
      <Briefcase size={20} />
    </Button>
  </li>
  <li class="navbar__item">
    <Button
      text={t.nav.contact[l]}
      ariaLabel={t.nav.contact[l]}
      link="#contact"
      iconPosition="left"
      target="_self"
      width="auto"
    >
      <Mail size={20} />
    </Button>
  </li>
  <li class="navbar__item navbar__item--lang">
    <Button
      text="ES"
      link="/es/"
      target="_self"
      iconPosition="right"
      width="auto"
      isalink={true}
      ariaLabel="ES"
    />
  </li>
  <li class="navbar__item navbar__item--lang">
    <Button
      text="EN"
      link="/en/"
      target="_self"
      iconPosition="right"
      width="auto"
      isalink={true}
      ariaLabel="EN"
    />
  </li>
</ul>

<style>
  .navbar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
  }
  .navbar__item {
    list-style: none;
  }

  :global(.navbar__item .icon) {
    display: none;
  }

  @media (max-width: 767px) {
    .navbar {
      width: 100%;
      max-width: 420px;
      margin-inline: auto;
      gap: 4px;
      padding: 8px 12px;
    }

    .navbar__item {
      flex: 1;
      min-width: 0;
    }

    :global(.navbar__item .button) {
      width: 100% !important;
      height: 44px;
      padding: 6px !important;
    }

    :global(.navbar__item .content .medium) {
      display: none;
    }

    :global(.navbar__item--lang .content .medium) {
      display: inline;
      font-size: 0.95rem;
    }

    :global(.navbar__item .icon) {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 360px) {
    .navbar {
      gap: 2px;
      padding-inline: 10px;
    }

    :global(.navbar__item .button) {
      padding: 4px !important;
    }
  }
</style>
