---
interface Props {
  text?: string;
  textSize?: "small" | "medium" | "large";
  iconPosition?: "left" | "right" | "none";
  href?: string;
  target?: string;
  rel?: string;
  width?: string;
  borderColor?: string;
  ariaLabel?: string;
  class?: string;
  [key: string]: any;
}

const {
  text = "",
  textSize = "medium",
  iconPosition = "left",
  href,
  target = "_blank",
  rel,
  width,
  borderColor,
  ariaLabel,
  class: className,
  ...rest
} = Astro.props;

const relValue =
  rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
const borderVars = borderColor
  ? `--button-color: #${borderColor}59; --button-color-hover: #${borderColor}ff;`
  : undefined;
const widthStyle = width ? `width: ${width};` : undefined;
---

<div class="button-wrapper" style={borderVars}>
  {
    href ? (
      <a
        {...rest}
        class:list={["button", className]}
        style={widthStyle + (rest.style ? rest.style : "")}
        href={href}
        target={target}
        rel={relValue}
        aria-label={ariaLabel}
      >
        <div class="content">
          {iconPosition === "left" && (
            <div class="icon">
              <slot />
            </div>
          )}
          {text && <div class={textSize}>{text}</div>}
          {iconPosition === "right" && (
            <div class="icon">
              <slot />
            </div>
          )}
        </div>
      </a>
    ) : (
      <button
        {...rest}
        class:list={["button", className]}
        style={widthStyle}
        type="button"
        aria-label={ariaLabel}
      >
        <div class="content">
          {iconPosition === "left" && (
            <div class="icon">
              <slot />
            </div>
          )}
          {text && <div class={textSize}>{text}</div>}
          {iconPosition === "right" && (
            <div class="icon">
              <slot />
            </div>
          )}
        </div>
      </button>
    )
  }
</div>

<style>
  .button:has(.small) {
    padding: 0.5rem;
    font-size: 1rem;
  }
  .button:has(.medium) {
    padding: 1rem 1.5rem;
    font-size: 1.25rem;
  }
  .button:has(.large) {
    padding: 2rem;
    font-size: 1.5rem;
  }
  .button {
    display: flex;
    width: 76px;
    color: white;
    padding: 1.5rem;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
    background: #151515;
    border: none;
    cursor: pointer;
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
    /* botones */

    /* box-shadow: 0 3px 11px var(--spread, 5px) #385eb259; */
    transition: box-shadow 0.3s ease-in-out;
  }
  .button:focus-visible {
    outline: 2px solid var(--button-color-hover, #385fb2ff);
    outline-offset: 3px;
  }
  .button-wrapper {
    padding: 3px;

    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
    background-color: var(--button-color, #385fb24d);
    border-radius: 12px;
    transition: background-color 0.3s ease-in-out;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content {
    width: fit-content;
    transition: transform 0.3s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 600;
  }

  .button:hover .content {
    transform: scale(1.1);
  }

  .button-wrapper:has(.button:hover) {
    background-color: var(--button-color-hover, #385fb2ff);
  }

  @media (max-width: 760px) {
    .button {
      width: 69px;
      height: 69px;
      padding: 20px;

      gap: 10px;
    }
  }
</style>
